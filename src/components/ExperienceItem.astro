---
interface Props {
  title: string;
  company: string;
  date: string;
  description?: string;
  stack?: string[];
}

const { title, company, date, description, stack } = Astro.props;
---

<div class="p-6 rounded-2xl bg-white dark:bg-gray-900/50 border border-gray-100 dark:border-gray-800 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-all hover:shadow-md">
  <div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-4">
    <div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">{title}</h3>
      <h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">{company}</h4>
    </div>
    <div class="text-sm font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 px-3 py-1 rounded-full w-fit mt-1 md:mt-0">
      {date}
    </div>
  </div>
  
  {description && <p class="text-gray-600 dark:text-gray-400 mt-2 text-balance leading-relaxed text-sm md:text-base">{description}</p>}
  
  {stack && stack.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-5">
      {stack.map((tech) => (
        <span class="px-2.5 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-md text-xs font-semibold border border-gray-200 dark:border-gray-700">
          {tech}
        </span>
      ))}
    </div>
  )}
</div>
