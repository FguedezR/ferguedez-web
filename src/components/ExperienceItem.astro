---
interface Props {
  title: string;
  company: string;
  date: string;
  description?: string;
  stack?: string[];
}

const { title, company, date, description, stack } = Astro.props;
---

<article class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-x-8 gap-y-2 py-6 border-b border-line last:border-b-0">
  <div class="label-mono text-subtle pt-1">{date}</div>

  <div>
    <h3 class="text-base md:text-lg font-medium tracking-tight text-fg">{title}</h3>
    <p class="text-sm text-muted mt-0.5">{company}</p>

    {description && <p class="text-muted mt-3 leading-relaxed text-pretty max-w-[62ch]">{description}</p>}

    {stack && stack.length > 0 && (
      <p class="font-mono text-xs text-subtle mt-4 leading-relaxed">
        {stack.join(' · ')}
      </p>
    )}
  </div>
</article>
