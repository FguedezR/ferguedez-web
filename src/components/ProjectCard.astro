---
interface Props {
  index: string;
  title: string;
  description: string;
  image: string;
  tags: string[];
  link?: string;
}

const { index, title, description, image, tags, link = "#" } = Astro.props;
---

<article class="group grid grid-cols-1 md:grid-cols-[1fr_1.15fr] gap-6 md:gap-10 py-10 border-b border-line last:border-b-0 first:pt-0">
  <div class="flex flex-col order-2 md:order-1">
    <span class="label-mono text-subtle">{index}</span>

    <h3 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight text-fg">
      <a href={link} target="_blank" rel="noopener noreferrer" class="decoration-1 underline-offset-4 group-hover:underline">
        {title}
      </a>
    </h3>

    <p class="mt-3 text-muted leading-relaxed text-pretty">{description}</p>

    <ul class="mt-5 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <li class="label-mono text-muted px-2 py-1 border border-line rounded-xs">{tag}</li>
      ))}
    </ul>

    <a href={link} target="_blank" rel="noopener noreferrer" class="mt-6 md:mt-auto pt-0 md:pt-6 label-mono text-accent link-underline w-fit">
      Visit project ↗
    </a>
  </div>

  <a href={link} target="_blank" rel="noopener noreferrer" class="order-1 md:order-2 block overflow-hidden rounded-md border border-line bg-surface aspect-[16/10]" tabindex="-1" aria-hidden="true">
    <img src={image} alt="" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]" loading="lazy" decoding="async" />
  </a>
</article>
