---
import { ArrowRight } from 'lucide-react';
import HeroField from './HeroField.astro';
---

<section id="home" class="relative isolate pt-16 pb-20 md:pt-24 md:pb-28">
  <!-- Interactive dot field -->
  <HeroField />

  <div class="space-y-8 animate-fade-in-up">
    <!-- Meta line -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 label-mono text-muted">
      <span>Madrid, ES</span>
      <span class="text-line-strong">/</span>
      <span class="inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Available for work
      </span>
    </div>

    <!-- Main Typography -->
    <div class="space-y-4">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold tracking-[-0.035em] leading-[1.02] text-fg">
        Fernando Guedez
      </h1>
      <p class="text-lg md:text-2xl font-normal tracking-tight text-muted">
        Web Designer &amp; Full Stack Developer
      </p>
    </div>

    <!-- Description -->
    <p class="max-w-[60ch] text-base md:text-lg leading-relaxed text-muted text-pretty">
      Crafting premium, high-performance web experiences through strategic design and robust full-stack development.
    </p>

    <!-- CTA & Socials -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a href="mailto:contact@ferguedez.dev" class="group inline-flex items-center gap-2 h-10 px-4 rounded-sm bg-fg text-bg text-sm font-medium hover:opacity-90 transition-opacity">
        Get in touch
        <ArrowRight size={16} strokeWidth={1.75} className="group-hover:translate-x-0.5 transition-transform" />
      </a>
      <a href="https://github.com/FguedezR" target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-10 px-4 rounded-sm border border-line text-sm text-fg hover:border-line-strong hover:bg-surface transition-colors">
        GitHub <span class="ml-1.5 text-subtle">↗</span>
      </a>
      <a href="https://www.linkedin.com/in/fernando-guedez" target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-10 px-4 rounded-sm border border-line text-sm text-fg hover:border-line-strong hover:bg-surface transition-colors">
        LinkedIn <span class="ml-1.5 text-subtle">↗</span>
      </a>
    </div>

    <!-- Latest -->
    <a href="#lab" class="group inline-flex flex-wrap items-baseline gap-x-3 gap-y-1 pt-4 text-sm text-muted hover:text-fg transition-colors">
      <span class="label-mono text-accent">Latest</span>
      <span><span class="text-fg font-medium">WebP Converter</span> — an in-browser image optimizer</span>
      <span class="text-subtle group-hover:translate-y-0.5 transition-transform">↓</span>
    </a>
  </div>
</section>
