---
import { MapPin, ArrowRight } from 'lucide-react';
---

<section id="home" class="relative py-20 md:py-32 flex flex-col justify-center min-h-[80vh] overflow-visible">
  <!-- Subtle background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[800px] md:h-[800px] bg-blue-500/10 dark:bg-blue-500/15 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="relative z-10 space-y-8 animate-fade-in-up" style="animation-fill-mode: both;">
    <!-- Location Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-gray-900/80 border border-gray-200 dark:border-gray-800 text-sm font-semibold text-gray-700 dark:text-gray-300 backdrop-blur-md shadow-sm">
      <MapPin size={16} className="text-blue-500 dark:text-blue-400" />
      <span>Madrid, Spain</span>
      <div class="w-[1px] h-4 bg-gray-300 dark:bg-gray-700 mx-1"></div>
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Available for work</span>
    </div>

    <!-- Main Typography -->
    <div class="space-y-4 md:space-y-6">
      <h1 class="text-6xl md:text-8xl lg:text-[7rem] font-black tracking-tight text-gray-900 dark:text-white leading-[0.95] drop-shadow-sm">
        Fernando<br class="hidden md:block" /> Guedez.
      </h1>
      <h2 class="text-xl md:text-3xl lg:text-4xl font-bold tracking-tight bg-clip-text text-transparent bg-linear-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400">
        Web Designer & Full Stack Developer
      </h2>
    </div>

    <!-- Description -->
    <p class="max-w-3xl text-xl md:text-2xl text-gray-600 dark:text-gray-400 leading-relaxed text-balance font-medium">
      Crafting premium, high-performance web experiences through strategic design and robust full-stack development.
    </p>
    
    <!-- CTA & Socials -->
    <div class="flex flex-wrap items-center gap-6 pt-6">
      <a href="mailto:contact@ferguedez.dev" class="inline-flex items-center gap-3 px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-full text-base font-bold hover:scale-105 transition-all active:scale-95 shadow-xl hover:shadow-2xl group">
        Get in touch
        <ArrowRight size={20} className="group-hover:translate-x-1 transition-transform" />
      </a>

      <div class="flex items-center gap-4">
        <a href="https://github.com/FguedezR" target="_blank" rel="noopener noreferrer" class="p-4 bg-white dark:bg-gray-900/80 rounded-full text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:scale-110 transition-all border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/fernando-guedez" target="_blank" rel="noopener noreferrer" class="p-4 bg-white dark:bg-gray-900/80 rounded-full text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:scale-110 transition-all border border-gray-200 dark:border-gray-800 shadow-sm hover:shadow-md" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
