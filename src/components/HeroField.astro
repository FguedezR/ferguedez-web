---
// Interactive dot field behind the hero: a "plot" that reacts to the cursor.
// Dots near the pointer grow, shift and take the accent colour; a dashed crosshair
// shows normalised coordinates; clicking emits a ripple. On touch devices a slow
// Lissajous attractor animates the field. Respects prefers-reduced-motion.
---

<canvas
  data-hero-field
  class="hero-field absolute -inset-x-8 inset-y-0 -z-10 h-full w-[calc(100%+4rem)] pointer-events-none font-mono"
  aria-hidden="true"
></canvas>

<style>
  .hero-field {
    mask-image: radial-gradient(ellipse 95% 90% at 50% 45%, #000 40%, transparent 92%);
  }
</style>

<script>
  type Ripple = { x: number; y: number; t: number };

  const SPACING = 22;
  const RADIUS = 140; // pointer influence radius (px)
  const PUSH = 9; // max displacement (px)
  const RIPPLE_SPEED = 0.45; // px per ms
  const RIPPLE_LIFE = 1400; // ms
  const RIPPLE_BAND = 38; // px

  const setup = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-field]');
    const host = canvas?.parentElement;
    if (!canvas || !host || canvas.dataset.ready) return;
    canvas.dataset.ready = '1';

    const ctx = canvas.getContext('2d')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touchOnly = window.matchMedia('(hover: none)').matches;

    let w = 0, h = 0, dpr = 1;
    let colors = { dot: '', accent: '', label: '' };
    let font = '';

    // Smoothed pointer state
    const target = { x: 0, y: 0 };
    const p = { x: 0, y: 0 };
    let inside = false;
    let presence = 0; // 0..1 fade of the pointer effect
    const ripples: Ripple[] = [];

    let raf = 0;
    let visible = true;
    let start = performance.now();

    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      colors = {
        dot: s.getPropertyValue('--c-subtle').trim(),
        accent: s.getPropertyValue('--c-accent').trim(),
        label: s.getPropertyValue('--c-muted').trim(),
      };
      font = `500 10px ${getComputedStyle(canvas).fontFamily}`;
    };

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const smooth = (t: number) => t * t * (3 - 2 * t);

    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);

      // Touch devices: wandering attractor at reduced strength
      let strength = presence;
      if (touchOnly && !reduceMotion) {
        const t = (now - start) / 1000;
        p.x = w * (0.5 + 0.38 * Math.sin(t * 0.31));
        p.y = h * (0.5 + 0.32 * Math.sin(t * 0.47 + 1.3));
        strength = 0.55;
      }

      const offX = (w % SPACING) / 2;
      const offY = (h % SPACING) / 2;

      for (let gx = offX; gx <= w; gx += SPACING) {
        for (let gy = offY; gy <= h; gy += SPACING) {
          let dx = gx - p.x;
          let dy = gy - p.y;
          const d = Math.hypot(dx, dy) || 1;

          let f = d < RADIUS ? smooth(1 - d / RADIUS) * strength : 0;
          let ox = (dx / d) * f * PUSH;
          let oy = (dy / d) * f * PUSH;

          // Ripples: a travelling ring that pushes dots outward
          for (const r of ripples) {
            const age = now - r.t;
            const ring = age * RIPPLE_SPEED;
            const rdx = gx - r.x;
            const rdy = gy - r.y;
            const rd = Math.hypot(rdx, rdy) || 1;
            const band = 1 - Math.abs(rd - ring) / RIPPLE_BAND;
            if (band > 0) {
              const k = smooth(band) * (1 - age / RIPPLE_LIFE);
              ox += (rdx / rd) * k * 6;
              oy += (rdy / rd) * k * 6;
              f = Math.max(f, k * 0.8);
            }
          }

          const x = gx + ox;
          const y = gy + oy;
          const radius = 0.85 + f * 2.1;

          ctx.globalAlpha = 0.45 + f * 0.55;
          ctx.fillStyle = f > 0.04 ? colors.accent : colors.dot;
          ctx.beginPath();
          ctx.arc(x, y, radius, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Crosshair + coordinate readout (pointer only)
      if (!touchOnly && presence > 0.01) {
        ctx.globalAlpha = presence * 0.45;
        ctx.strokeStyle = colors.dot;
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 4]);
        ctx.beginPath();
        ctx.moveTo(Math.round(p.x) + 0.5, 0);
        ctx.lineTo(Math.round(p.x) + 0.5, h);
        ctx.moveTo(0, Math.round(p.y) + 0.5);
        ctx.lineTo(w, Math.round(p.y) + 0.5);
        ctx.stroke();
        ctx.setLineDash([]);

        const label = `x ${(p.x / w).toFixed(3)}  y ${(1 - p.y / h).toFixed(3)}`;
        ctx.font = font;
        ctx.fillStyle = colors.label;
        ctx.globalAlpha = presence;
        const tw = ctx.measureText(label).width;
        const lx = p.x + 14 + tw > w ? p.x - 14 - tw : p.x + 14;
        const ly = p.y + 22 > h ? p.y - 12 : p.y + 22;
        ctx.fillText(label, lx, ly);
      }

      ctx.globalAlpha = 1;
    };

    const tick = (now: number) => {
      p.x += (target.x - p.x) * 0.16;
      p.y += (target.y - p.y) * 0.16;
      presence += ((inside ? 1 : 0) - presence) * 0.08;
      while (ripples.length && now - ripples[0].t > RIPPLE_LIFE) ripples.shift();

      draw(now);

      const settled = !touchOnly && !inside && presence < 0.005 && !ripples.length;
      raf = visible && !settled ? requestAnimationFrame(tick) : 0;
    };

    const wake = () => {
      if (!raf && visible && !reduceMotion) raf = requestAnimationFrame(tick);
    };

    const localPoint = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };

    readTheme();
    resize();

    if (reduceMotion) {
      draw(performance.now());
    } else {
      host.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
        const pt = localPoint(e);
        if (!inside) { p.x = pt.x; p.y = pt.y; }
        target.x = pt.x;
        target.y = pt.y;
        inside = true;
        wake();
      });
      host.addEventListener('pointerleave', () => { inside = false; wake(); });
      host.addEventListener('pointerdown', (e) => {
        // Don't ripple when using the buttons/links
        if ((e.target as HTMLElement).closest('a, button')) return;
        const pt = localPoint(e);
        ripples.push({ x: pt.x, y: pt.y, t: performance.now() });
        if (ripples.length > 5) ripples.shift();
        wake();
      });

      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) wake();
      }).observe(host);

      draw(performance.now());
      if (touchOnly) wake();
    }

    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(canvas);

    // Re-read colours when the theme toggles
    new MutationObserver(() => { readTheme(); draw(performance.now()); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
