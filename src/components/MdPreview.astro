---
// Lightweight HTML mock of md.ferguedez.dev (no screenshot needed).
// Always dark, matching the tool's own look.
---

<div class="overflow-hidden rounded-md border border-line bg-[#0b0c0e] text-[#e8e8e8] font-mono flex flex-col transition-transform duration-700 ease-out group-hover:-translate-y-0.5">
  <!-- Window bar -->
  <div class="flex items-center gap-2 px-3 h-7 border-b border-white/10 text-[10px] text-white/40">
    <span class="flex gap-1.5">
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
    </span>
    <span class="mx-auto tracking-wide">md.ferguedez.dev</span>
  </div>

  <div class="flex-1 flex flex-col p-4 sm:p-5 gap-4">
    <div data-anchor="top" class="flex justify-between text-[8px] sm:text-[9px] uppercase tracking-[0.12em] text-white/40">
      <span>Runs in your browser · no uploads</span>
      <span class="hidden sm:inline">GitHub ↗</span>
    </div>

    <p class="text-2xl sm:text-3xl leading-[1.02] tracking-tight">MD<br />Converter</p>

    <div data-anchor="drop" class="mt-2 rounded-[3px] border border-dashed border-white/20 bg-white/[0.02] px-3 py-3 sm:py-4 transition-colors group-hover:border-white/40">
      <p class="text-[10px] sm:text-xs text-white/80">Drop documents</p>
      <p class="mt-1 text-[8px] sm:text-[9px] tracking-[0.12em] text-white/35">PDF · DOCX · PPTX · ODT · RTF · LaTeX · HTML</p>
    </div>

    <!-- Editor: source | preview -->
    <div data-anchor="split" class="grid grid-cols-2 rounded-[3px] border border-white/10 text-[8px] sm:text-[9px] leading-relaxed">
      <div class="px-2.5 py-2 border-r border-white/10 text-white/50">
        <p><span class="text-white/80">## Notes</span></p>
        <p>- **fast**</p>
        <p>- private</p>
      </div>
      <div class="px-2.5 py-2">
        <p class="text-white/90 font-semibold">Notes</p>
        <p class="text-white/60">• <span class="text-white/90 font-semibold">fast</span></p>
        <p class="text-white/60">• private</p>
      </div>
    </div>
  </div>
</div>
