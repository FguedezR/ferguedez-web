---
import Section from './Section.astro';

const devSkills = [
  'JavaScript', 'React/Next.js', 'Node.js', 'Nest.js',
  'MongoDB', 'Git', 'ExpressJS', 'TailwindCSS', 'CSS', 'HTML'
];

const designSkills = [
  'Figma', 'Illustrator', 'Photoshop', 'InDesign', 'Adobe XD'
];

const groups = [
  { title: 'Development', skills: devSkills },
  { title: 'Design', skills: designSkills },
];
---

<Section id="about" index="01" title="About">
  <div class="space-y-10">
    <p class="max-w-[64ch] text-lg leading-relaxed text-muted text-pretty">
      I am a hybrid professional passionate about technology and aesthetics, with the ability to transition from the visual conceptualization of a product to its architectural implementation in code.
    </p>

    <dl class="grid grid-cols-1 md:grid-cols-2 gap-px bg-line border border-line rounded-md overflow-hidden">
      {groups.map((g) => (
        <div class="bg-bg p-5">
          <dt class="label-mono text-subtle mb-4">{g.title}</dt>
          <dd class="flex flex-wrap gap-1.5">
            {g.skills.map((skill) => (
              <span class="font-mono text-xs text-fg px-2 py-1 border border-line rounded-xs bg-surface">
                {skill}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
