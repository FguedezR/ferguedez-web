---
// Lightweight HTML mock of webp.ferguedez.dev (no screenshot needed).
// Always dark, matching the tool's own look.
---

<div class="overflow-hidden rounded-md border border-line bg-[#0b0c0e] text-[#e8e8e8] font-mono flex flex-col transition-transform duration-700 ease-out group-hover:-translate-y-0.5">
  <!-- Window bar -->
  <div class="flex items-center gap-2 px-3 h-7 border-b border-white/10 text-[10px] text-white/40">
    <span class="flex gap-1.5">
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
      <span class="h-2 w-2 rounded-full bg-white/15"></span>
    </span>
    <span class="mx-auto tracking-wide">webp.ferguedez.dev</span>
  </div>

  <div class="flex-1 flex flex-col p-4 sm:p-5 gap-4">
    <div class="flex justify-between text-[8px] sm:text-[9px] uppercase tracking-[0.12em] text-white/40">
      <span>Procesado en tu navegador · sin subidas</span>
      <span class="hidden sm:inline">GitHub ↗</span>
    </div>

    <p class="text-2xl sm:text-3xl leading-[1.02] tracking-tight">WebP<br />Converter</p>

    <div class="mt-2 rounded-[3px] border border-dashed border-white/20 bg-white/[0.02] px-3 py-3 sm:py-4 transition-colors group-hover:border-white/40">
      <p class="text-[10px] sm:text-xs text-white/80">Suelta imágenes o una carpeta</p>
      <p class="mt-1 text-[8px] sm:text-[9px] tracking-[0.12em] text-white/35">PNG · JPG · SVG · GIF · BMP · HEIC · TIFF</p>
    </div>

    <div class="flex items-center gap-2 text-[8px] sm:text-[9px] uppercase tracking-[0.12em]">
      <span class="text-white/40">Calidad 65</span>
      <span class="relative h-px flex-1 bg-white/15">
        <span class="absolute inset-y-0 left-0 w-[65%] bg-white/60"></span>
      </span>
      <span class="px-2 py-1 rounded-[2px] bg-white text-black">Convertir</span>
      <span class="px-2 py-1 rounded-[2px] border border-white/20 text-white/60">ZIP</span>
    </div>
  </div>
</div>
