---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SideIndex from '../components/SideIndex.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import CertificationItem from '../components/CertificationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LabItem from '../components/LabItem.astro';
import WebpPreview from '../components/WebpPreview.astro';

const projects = [
  {
    title: 'David Vidales',
    description: 'Renewing the digital presence of the pilot. We built an attractive identity highlighting the fusion between art and engineering.',
    image: 'https://hadock.es/wp-content/uploads/2024/10/proyecto_david_vidales.webp',
    tags: ['Web Design', 'Branding', 'Marketing'],
    link: 'https://davidvidalesracing.com/',
  },
  {
    title: 'Brick Estudio',
    description: 'Platform with a contemporary and renewed approach to integral architecture.',
    image: 'https://hadock.es/wp-content/uploads/2025/11/proyecto-brick-estudio-second-main.webp',
    tags: ['Branding', 'Web Design'],
    link: 'https://brickestudio.com/',
  },
  {
    title: 'Marcodecor',
    description: "eCommerce and web creation. A window to your memories, the 'House of Photo Frames'.",
    image: 'https://hadock.es/wp-content/uploads/2023/08/marcodecor_background.jpg',
    tags: ['eCommerce', 'Web Design'],
    link: 'https://www.marcodecor.com/',
  },
  {
    title: 'Estudio Ollero',
    description: 'We refreshed the visual identity to reflect the generational handover of this architecture studio.',
    image: 'https://hadock.es/wp-content/uploads/2025/10/estudio-ollero-proyecto-la-torre-1.webp',
    tags: ['Branding', 'Web Design'],
    link: 'https://estudioollero.es/',
  },
  {
    title: 'Ramón Fernández-Alonso',
    description: 'Relaunch of an architecture studio creating a compelling brand to bring its vision to life.',
    image: 'https://hadock.es/wp-content/uploads/2024/10/Escuela-Universitaria-de-Magisterio_1.jpg',
    tags: ['Consulting', 'Web Design'],
    link: 'https://fernandezalonso.com/',
  },
];
---

<Layout title="Fernando Guedez | Web Designer & Full Stack Developer" description="Fernando Guedez's Portfolio - Crafting premium, high-performance web experiences through strategic design and robust full-stack development.">
  <Header />

  <div class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6 lg:px-8 lg:grid lg:grid-cols-[200px_1fr] lg:gap-16">
    <SideIndex />

    <main class="min-w-0 max-w-3xl mb-16">
      <Hero />
      <AboutMe />

      <Section id="experience" index="02" title="Experience">
        <ExperienceItem
          date="Sept 2025 – Present"
          title="Web Developer & Web Designer"
          company="Hadock Comunicación"
          description="Focus on Full Stack Web Development and Design."
          stack={['Astro', 'React', 'TailwindCSS', 'Figma', 'WordPress']}
        />
        <ExperienceItem
          date="Mar 2024 – Sept 2025"
          title="Web Designer"
          company="Hadock Comunicación"
          description="Focus on Web Design and WooCommerce projects."
          stack={['WordPress', 'WooCommerce', 'CSS', 'HTML', 'JavaScript', 'Figma']}
        />
        <ExperienceItem
          date="Jun 2022 – Mar 2024"
          title="Graphic Designer"
          company="Hadock Comunicación"
          description="Visual Identity and Branding for various brands."
          stack={['Illustrator', 'Photoshop', 'InDesign']}
        />
      </Section>

      <Section id="education" index="03" title="Education">
        <ExperienceItem
          date="2026"
          title="Full Stack & UX/UI Bootcamp"
          company="The Bridge"
        />
        <ExperienceItem
          date="2022"
          title="Graphic Design and Print & Multimedia Publications Technician"
          company="Professional Education Tajamar"
        />
      </Section>

      <Section id="certifications" index="04" title="Certifications">
        <CertificationItem
          date="Mar 2026"
          title="Claude Code in Action"
          issuer="Anthropic"
          link="https://verify.skilljar.com/c/423n4k7kv8x7"
        />
        <CertificationItem
          date="Dec 2025"
          title="MongoDB"
          issuer="MongoDB University"
          link="https://www.credly.com/badges/929ea7d2-bd26-4ef8-a5e1-04977c3d60e1/linked_in_profile"
        />
      </Section>

      <Section id="projects" index="05" title="Selected Projects">
        {projects.map((p, i) => (
          <ProjectCard index={String(i + 1).padStart(2, '0')} {...p} />
        ))}
      </Section>

      <Section id="lab" index="06" title="Lab">
        <p class="-mt-4 mb-10 max-w-[60ch] text-muted leading-relaxed">
          Small tools and experiments built in the open.
        </p>
        <LabItem
          label="Latest"
          title="WebP Converter"
          description="A privacy-first image converter that runs entirely in the browser, with no uploads. Drop images or a whole folder, set quality and maximum size, and download optimized WebP files as a ZIP."
          tags={['Tool', 'Client-side', 'Image optimization']}
          link="https://webp.ferguedez.dev/"
        >
          <WebpPreview slot="preview" />
        </LabItem>
      </Section>
    </main>
  </div>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between label-mono text-subtle">
      <p>© {new Date().getFullYear()} Fernando Guedez</p>
      <div class="flex gap-5">
        <a href="mailto:contact@ferguedez.dev" class="hover:text-fg transition-colors">Email</a>
        <a href="https://github.com/FguedezR" target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/fernando-guedez" target="_blank" rel="noopener noreferrer" class="hover:text-fg transition-colors">LinkedIn</a>
      </div>
    </div>
  </footer>
</Layout>
